+/*
+ * vayu touch screen: Novatek NT36672C on SPI (QUP wrapper 2, engine se17 at 0xc80000).
+ * Staged by boot-arg sweettouch (nothing runs unless it is 2 or 3):
+ *
+ *   2  passive probe: reads clock and pin state, writes NOTHING.
+ *   3  chip probe: turns the engine's three clocks on, sets the four SPI pins, brings up the
+ *      engine in FIFO mode (polled), resets the touch MCU into its boot ROM exactly as
+ *      Xiaomi's driver does (write 0x69 to 0x3F0FE), and reads the chip ID (0x1F64E).
+ *      The reset pin (GPIO 12) is NOT touched: on this chip it may be shared with the
+ *      display. No firmware is sent and no touch reports are read.
+ *
+ * Every step checks its result and logs one line; a failing step stops the driver.
+ *
+ * Where the numbers come from:
+ *   clocks, QUP2 se0:   Xiaomi vayu-r-oss drivers/clk/qcom/gcc-sm8150.c (vote 0x52014 bits 1,2,4;
+ *                       CBCR 0x1e004 0x1e008 0x1e144; RCG 0x1e148, DFS layout as in clk-rcg2.c)
+ *   pins:               pinctrl-sm8150.c (tile base + 0x1000 * pin; NORTH 0x900000, SOUTH 0xd00000
+ *                       from the TLMM at 0x3000000); function 1 = qup17 on GPIO 55..58
+ *   SPI engine (GENI):  register layout of Linux drivers/spi/spi-geni-qcom.c, as used by another
+ *                       XNU port (hakios.goodix.c, APSL) for the same kind of engine
+ *   Novatek framing:    Xiaomi nt36672c/nt36xxx.c: page select [0xff, a>>15, a>>7]; write
+ *                       [(a&0x7f)|0x80, data]; read clocks len+1 bytes out, data from byte 2
+ * Status: written, not yet run on the phone.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void clock_interval_to_absolutetime_interval(uint32_t, uint32_t, uint64_t *);
+void sweet_nvt_start(int stage);
+
+/* ---- addresses ----------------------------------------------------------------------------- */
+#define NVT_GCC_PA      0x00100000u
+#define NVT_GCC_LEN     0x00060000u
+#define NVT_NORTH_PA    0x03900000u   /* TLMM 0x3000000 + NORTH 0x900000 */
+#define NVT_NORTH_LEN   0x00020000u
+#define NVT_SOUTH_PA    0x03d00000u   /* TLMM 0x3000000 + SOUTH 0xd00000 */
+#define NVT_SOUTH_LEN   0x00080000u
+#define NVT_SE_PA       0x00c80000u
+#define NVT_SE_LEN      0x00004000u
+
+#define GCC_VOTE        0x52014u      /* bit1 s_ahb, bit2 m_ahb, bit4 s0 clock */
+#define VOTE_S_AHB      (1u << 1)
+#define VOTE_M_AHB      (1u << 2)
+#define VOTE_S0         (1u << 4)
+#define GCC_M_AHB       0x1e004u
+#define GCC_S_AHB       0x1e008u
+#define GCC_S0          0x1e144u
+#define GCC_RCG_CMD     0x1e148u
+#define GCC_RCG_CFG     0x1e14cu
+#define GCC_RCG_DFSR    0x1e15cu      /* cmd + 0x14: bit 0 = engine picks preset rates */
+#define GCC_RCG_PCFG(l) (0x1e164u + 4u * (l))   /* cmd + 0x1c */
+#define GCC_RCG_PM(l)   (0x1e1a4u + 4u * (l))   /* cmd + 0x5c */
+#define GCC_RCG_PN(l)   (0x1e1e4u + 4u * (l))   /* cmd + 0x9c */
+#define CLK_OFF         (1u << 31)
+#define XO_HZ           19200000u
+
+#define PIN_MISO        55u
+#define PIN_MOSI        56u
+#define PIN_CLK         57u
+#define PIN_CS          58u
+#define PIN_RESET       12u           /* read only */
+#define PIN_IRQ         122u          /* read only */
+#define PIN_FUNC_SPI    1u            /* qup17 */
+
+/* GENI serial engine */
+#define GENI_FORCE_DEFAULT  0x020u
+#define GENI_OUTPUT_CTRL    0x024u
+#define GENI_CGC_CTRL       0x028u
+#define GENI_STATUS         0x040u
+#define GENI_SER_M_CLK_CFG  0x048u
+#define GENI_IF_DISABLE_RO  0x064u
+#define GENI_FW_REVISION_RO 0x068u
+#define GENI_CLK_SEL        0x07cu
+#define SPI_CPHA            0x224u
+#define SPI_LOOPBACK        0x22cu
+#define SPI_CPOL            0x230u
+#define SPI_DEMUX_OUT_INV   0x24cu
+#define SPI_DEMUX_SEL       0x250u
+#define GENI_BYTE_GRAN      0x254u
+#define GENI_DMA_MODE_EN    0x258u
+#define SPI_TRANS_CFG       0x25cu
+#define GENI_TX_PACK0       0x260u
+#define GENI_TX_PACK1       0x264u
+#define SPI_WORD_LEN        0x268u
+#define SPI_TX_TRANS_LEN    0x26cu
+#define SPI_RX_TRANS_LEN    0x270u
+#define SPI_DELAY_COUNTERS  0x278u
+#define GENI_RX_PACK0       0x284u
+#define GENI_RX_PACK1       0x288u
+#define GENI_M_CMD0         0x600u
+#define GENI_M_CMD_CTRL     0x604u
+#define GENI_M_IRQ_STATUS   0x610u
+#define GENI_M_IRQ_EN       0x614u
+#define GENI_M_IRQ_CLEAR    0x618u
+#define GENI_S_IRQ_CLEAR    0x648u
+#define GENI_TX_FIFO        0x700u
+#define GENI_RX_FIFO        0x780u
+#define GENI_TX_FIFO_STATUS 0x800u
+#define GENI_RX_FIFO_STATUS 0x804u
+#define GENI_TX_WATERMARK   0x80cu
+#define GENI_RX_WATERMARK   0x810u
+#define GENI_RX_RFR_WM      0x814u
+#define SE_DMA_TX_IRQ_CLR   0xc44u
+#define SE_DMA_RX_IRQ_CLR   0xd44u
+#define SE_GSI_EVENT_EN     0xe18u
+#define SE_IRQ_EN           0xe1cu
+#define SE_HW_PARAM_0       0xe24u
+#define SE_DMA_GENERAL_CFG  0xe30u
+#define M_CMD_DONE          (1u << 0)
+#define M_CMD_CANCEL        (1u << 4)
+#define M_CMD_ABORT         (1u << 5)
+#define M_ERRORS            ((1u << 1) | (1u << 2) | (1u << 3) | (1u << 24) | (1u << 25) | (1u << 28) | (1u << 29))
+#define SPI_FULL_DUPLEX     (3u << 27)
+
+/* Novatek */
+#define NVT_SWRST_N8        0x3f0feu
+#define NVT_SPI_RD_FAST     0x3f310u
+#define NVT_CHIPID_PAGE     0x1f600u
+#define NVT_CHIPID_REG      0x4eu
+#define NVT_MAX_XFER        64u
+
+static vm_offset_t gcc, north, south, se;
+static uint32_t se_source_hz, se_clock_select, fifo_depth;
+static int nvt_chan;
+static bool nvt_started;
+
+#ifdef NVT_HOST_TEST
+extern uint32_t nvt_mock_rd(vm_offset_t b, uint32_t off);
+extern void nvt_mock_wr(vm_offset_t b, uint32_t off, uint32_t v);
+static inline uint32_t rd(vm_offset_t b, uint32_t off) { return nvt_mock_rd(b, off); }
+static inline void wr(vm_offset_t b, uint32_t off, uint32_t v) { nvt_mock_wr(b, off, v); }
+#else
+static inline uint32_t rd(vm_offset_t b, uint32_t off) { return *(volatile uint32_t *)(b + off); }
+static inline void wr(vm_offset_t b, uint32_t off, uint32_t v) { *(volatile uint32_t *)(b + off) = v; }
+#endif
+
+/* Busy wait (at most a few hundred microseconds per call, and only on failure paths in loops). */
+static void
+nvt_us(uint32_t us)
+{
+	uint64_t ticks, end;
+	clock_interval_to_absolutetime_interval(us, NSEC_PER_USEC, &ticks);
+	end = mach_absolute_time() + ticks;
+	while (mach_absolute_time() < end) {
+	}
+}
+
+static void
+nvt_wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&nvt_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- pins ------------------------------------------------------------------------------------ */
+/* Only the pins this driver uses; pinctrl-sm8150.c: GPIO 12 is NORTH, 55..58 and 122 are SOUTH. */
+static vm_offset_t
+pin_tile(unsigned pin)
+{
+	switch (pin) {
+	case PIN_RESET:
+		return north;
+	case PIN_MISO:
+	case PIN_MOSI:
+	case PIN_CLK:
+	case PIN_CS:
+	case PIN_IRQ:
+		return south;
+	default:
+		return 0;
+	}
+}
+
+static void
+pin_show(unsigned pin, const char *name)
+{
+	if (!pin_tile(pin)) {
+		return;
+	}
+	uint32_t ctl = rd(pin_tile(pin), pin * 0x1000u);
+	uint32_t io = rd(pin_tile(pin), pin * 0x1000u + 4u);
+	printf("SWEET NVT: gpio%u %s ctl=%#x (mux %u pull %u drv %u oe %u) io=%#x (in %u out %u)\n",
+	    pin, name, ctl, (ctl >> 2) & 0xfu, ctl & 3u, (ctl >> 6) & 7u, (ctl >> 9) & 1u,
+	    io, io & 1u, (io >> 1) & 1u);
+}
+
+/* function, pull (0 none, 1 down, 2 keeper, 3 up), drive in mA */
+static void
+pin_spi(unsigned pin)
+{
+	if (pin != PIN_MISO && pin != PIN_MOSI && pin != PIN_CLK && pin != PIN_CS) {
+		return;   /* never writes any other pin */
+	}
+	wr(pin_tile(pin), pin * 0x1000u, 0u | (PIN_FUNC_SPI << 2) | ((6u / 2u - 1u) << 6));
+}
+
+/* ---- clocks ---------------------------------------------------------------------------------- */
+static uint32_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t not_n_minus_m)
+{
+	static const uint32_t parent[8] = { XO_HZ, 600000000u, 0, 0, 0, 0, 300000000u, 0 };
+	uint64_t hz = parent[(cfg >> 8) & 7u];
+	uint32_t divider = cfg & 0x1fu, mode = (cfg >> 12) & 3u;
+	if (divider) {
+		hz = hz * 2 / (divider + 1);
+	}
+	if (mode) {
+		uint32_t n = (~not_n_minus_m & 0xffffu) + (m & 0xffffu);
+		if (n) {
+			hz = hz * (m & 0xffffu) / n;
+		}
+	}
+	return (uint32_t)hz;
+}
+
+static bool
+clocks_on(void)
+{
+	wr(gcc, GCC_VOTE, rd(gcc, GCC_VOTE) | VOTE_S_AHB | VOTE_M_AHB);
+	if (rd(gcc, GCC_RCG_DFSR) & 1u) {
+		for (uint32_t level = 0; level < 8; level++) {
+			uint32_t hz = rcg_rate(rd(gcc, GCC_RCG_PCFG(level)), rd(gcc, GCC_RCG_PM(level)),
+			    rd(gcc, GCC_RCG_PN(level)));
+			printf("SWEET NVT: preset %u: %u Hz (cfg %#x)\n", level, hz, rd(gcc, GCC_RCG_PCFG(level)));
+			if (hz >= 4000000u && (se_source_hz == 0 || hz < se_source_hz)) {
+				se_source_hz = hz;
+				se_clock_select = level;
+			}
+		}
+		if (!se_source_hz) {
+			printf("SWEET NVT: no usable preset clock rate\n");
+			return false;
+		}
+	} else {
+		/* the crystal, undivided */
+		wr(gcc, GCC_RCG_CFG, (rd(gcc, GCC_RCG_CFG) & ~0x371fu) | 1u);
+		wr(gcc, GCC_RCG_CMD, rd(gcc, GCC_RCG_CMD) | 1u);
+		for (int i = 0; i < 500 && (rd(gcc, GCC_RCG_CMD) & 1u); i++) {
+			nvt_us(10);
+		}
+		if (rd(gcc, GCC_RCG_CMD) & 1u) {
+			printf("SWEET NVT: the engine clock does not take its configuration (%#x)\n", rd(gcc, GCC_RCG_CMD));
+			return false;
+		}
+		se_source_hz = XO_HZ;
+		se_clock_select = 0;
+	}
+	wr(gcc, GCC_VOTE, rd(gcc, GCC_VOTE) | VOTE_S0);
+	for (int i = 0; i < 1000; i++) {
+		if (!((rd(gcc, GCC_M_AHB) | rd(gcc, GCC_S_AHB) | rd(gcc, GCC_S0)) & CLK_OFF)) {
+			return true;
+		}
+		nvt_us(10);
+	}
+	printf("SWEET NVT: clocks stay off: m_ahb %#x s_ahb %#x s0 %#x\n", rd(gcc, GCC_M_AHB), rd(gcc, GCC_S_AHB),
+	    rd(gcc, GCC_S0));
+	return false;
+}
+
+/* ---- SPI engine ------------------------------------------------------------------------------ */
+static const char *
+geni_init(uint32_t hz)
+{
+	uint32_t divider;
+	if (((rd(se, GENI_FW_REVISION_RO) >> 8) & 0xffu) != 1u) {
+		return "the serial engine has no SPI firmware";
+	}
+	if (rd(se, GENI_IF_DISABLE_RO) & 1u) {
+		return "the serial engine's FIFO interface is disabled";
+	}
+	fifo_depth = (rd(se, SE_HW_PARAM_0) >> 16) & 0x3fu;
+	if (fifo_depth < 4u) {
+		return "the serial engine reports no FIFO";
+	}
+	wr(se, SE_GSI_EVENT_EN, 0);
+	wr(se, GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(se, GENI_S_IRQ_CLEAR, 0xffffffffu);
+	wr(se, SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	wr(se, SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	wr(se, GENI_CGC_CTRL, rd(se, GENI_CGC_CTRL) | 0x7fu);
+	wr(se, SE_DMA_GENERAL_CFG, rd(se, SE_DMA_GENERAL_CFG) | 0xfu);
+	wr(se, GENI_OUTPUT_CTRL, 0x7fu);
+	wr(se, GENI_FORCE_DEFAULT, 1u);
+	wr(se, GENI_DMA_MODE_EN, rd(se, GENI_DMA_MODE_EN) & ~1u);
+	wr(se, GENI_RX_WATERMARK, fifo_depth - 3u);
+	wr(se, GENI_RX_RFR_WM, fifo_depth - 2u);
+	wr(se, GENI_TX_WATERMARK, 0);
+	wr(se, SE_IRQ_EN, rd(se, SE_IRQ_EN) | 0xfu);
+	wr(se, GENI_M_IRQ_EN, rd(se, GENI_M_IRQ_EN) | 0x7fc0007fu);
+	/* mode 0, chip select 0, 8 bits, MSB first, four bytes per FIFO word */
+	wr(se, SPI_LOOPBACK, 0);
+	wr(se, SPI_DEMUX_SEL, 0);
+	wr(se, SPI_CPHA, 0);
+	wr(se, SPI_CPOL, 0);
+	wr(se, SPI_DEMUX_OUT_INV, 0);
+	wr(se, SPI_TRANS_CFG, rd(se, SPI_TRANS_CFG) & ~2u);
+	wr(se, SPI_DELAY_COUNTERS, 0);
+	wr(se, GENI_TX_PACK0, 0x0007f8feu);
+	wr(se, GENI_TX_PACK1, 0x000ffefeu);
+	wr(se, GENI_RX_PACK0, 0x0007f8feu);
+	wr(se, GENI_RX_PACK1, 0x000ffefeu);
+	wr(se, GENI_BYTE_GRAN, 0);
+	wr(se, SPI_WORD_LEN, 8u - 4u);
+	divider = (se_source_hz + hz - 1u) / hz;
+	wr(se, GENI_CLK_SEL, se_clock_select & 7u);
+	wr(se, GENI_SER_M_CLK_CFG, ((divider ? divider : 1u) << 4) | 1u);
+	return NULL;
+}
+
+static void
+geni_drain(uint8_t *rx, uint32_t length, uint32_t *received)
+{
+	uint32_t status = rd(se, GENI_RX_FIFO_STATUS), words = status & 0x01ffffffu, bytes = words * 4u;
+	if (status & 0x80000000u) {
+		uint32_t valid = (status >> 28) & 7u;
+		if (valid && valid < 4u) {
+			bytes -= 4u - valid;
+		}
+	}
+	for (uint32_t i = 0; i < words && i < 64u; i++) {
+		uint32_t word = rd(se, GENI_RX_FIFO);
+		for (int j = 0; j < 4 && bytes; j++, bytes--) {
+			if (*received < length) {
+				rx[*received] = (uint8_t)(word >> (8 * j));
+				(*received)++;
+			}
+		}
+	}
+}
+
+static void
+geni_recover(void)
+{
+	wr(se, GENI_M_CMD_CTRL, 1u << 2);
+	for (int i = 0; i < 2000 && !(rd(se, GENI_M_IRQ_STATUS) & M_CMD_CANCEL); i++) {
+		nvt_us(100);
+	}
+	if (!(rd(se, GENI_M_IRQ_STATUS) & M_CMD_CANCEL)) {
+		wr(se, GENI_M_CMD_CTRL, 1u << 1);
+		for (int i = 0; i < 2000 && !(rd(se, GENI_M_IRQ_STATUS) & M_CMD_ABORT); i++) {
+			nvt_us(100);
+		}
+	}
+	for (int i = 0; i < 64 && (rd(se, GENI_RX_FIFO_STATUS) & 0x01ffffffu); i++) {
+		(void)rd(se, GENI_RX_FIFO);
+	}
+	wr(se, GENI_M_IRQ_CLEAR, 0xffffffffu);
+}
+
+/* One full-duplex transfer of `length` bytes with the chip selected throughout. */
+static bool
+geni_xfer(const uint8_t *tx, uint8_t *rx, uint32_t length)
+{
+	uint32_t sent = 0, received = 0, status = 0;
+	uint64_t deadline;
+	if (length == 0 || length > NVT_MAX_XFER) {
+		return false;
+	}
+	for (int i = 0; rd(se, GENI_STATUS) & 1u; i++) {
+		if (i > 2000) {
+			geni_recover();
+			break;
+		}
+		nvt_us(100);
+	}
+	wr(se, GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(se, SPI_TX_TRANS_LEN, length);
+	wr(se, SPI_RX_TRANS_LEN, length);
+	wr(se, GENI_M_CMD0, SPI_FULL_DUPLEX);
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		while (sent < length && (rd(se, GENI_TX_FIFO_STATUS) & 0x0fffffffu) + 1u < fifo_depth) {
+			uint32_t word = 0;
+			for (int j = 0; j < 4 && sent < length; j++, sent++) {
+				word |= (uint32_t)(tx ? tx[sent] : 0) << (8 * j);
+			}
+			wr(se, GENI_TX_FIFO, word);
+		}
+		status = rd(se, GENI_M_IRQ_STATUS);
+		geni_drain(rx, length, &received);
+		if (status & M_ERRORS) {
+			break;
+		}
+		if (status & M_CMD_DONE) {
+			geni_drain(rx, length, &received);
+			wr(se, GENI_M_IRQ_CLEAR, status);
+			if (received == length) {
+				return true;
+			}
+			break;
+		}
+	}
+	printf("SWEET NVT: SPI transfer of %u bytes failed: status %#x sent %u received %u\n", length, status, sent, received);
+	geni_recover();
+	return false;
+}
+
+/* ---- Novatek framing --------------------------------------------------------------------------- */
+static bool
+nvt_write_bytes(const uint8_t *tx, uint32_t n)
+{
+	uint8_t rx[NVT_MAX_XFER];
+	return geni_xfer(tx, rx, n);
+}
+
+static bool
+nvt_set_page(uint32_t addr)
+{
+	uint8_t b[3] = { 0xffu, (uint8_t)((addr >> 15) & 0xffu), (uint8_t)((addr >> 7) & 0xffu) };
+	return nvt_write_bytes(b, 3);
+}
+
+static bool
+nvt_write_addr(uint32_t addr, uint8_t data)
+{
+	uint8_t b[2] = { (uint8_t)((addr & 0x7fu) | 0x80u), data };
+	return nvt_set_page(addr) && nvt_write_bytes(b, 2);
+}
+
+/* `len` includes the address byte, as in Xiaomi's CTP_SPI_READ: out[0] = address, data lands in out[1..len-1]. */
+static bool
+nvt_read(uint8_t *out, uint32_t len)
+{
+	uint8_t tx[NVT_MAX_XFER], rx[NVT_MAX_XFER];
+	if (len < 2 || len + 1 > NVT_MAX_XFER) {
+		return false;
+	}
+	memset(tx, 0, sizeof(tx));
+	tx[0] = out[0] & 0x7fu;
+	if (!geni_xfer(tx, rx, len + 1)) {
+		return false;
+	}
+	for (uint32_t i = 1; i < len; i++) {
+		out[i] = rx[i + 1];
+	}
+	return true;
+}
+
+static void
+nvt_thread(void *arg, wait_result_t w)
+{
+	int stage = (int)(intptr_t)arg;
+	int delay_s = 60;
+	(void)w;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	if (delay_s < 1 || delay_s > 600) {
+		delay_s = 60;
+	}
+	printf("SWEET NVT: stage %d starts in %d s\n", stage, delay_s);
+	nvt_wait_ms((unsigned)delay_s * 1000u);
+
+	gcc = ml_io_map(NVT_GCC_PA, NVT_GCC_LEN);
+	north = ml_io_map(NVT_NORTH_PA, NVT_NORTH_LEN);
+	south = ml_io_map(NVT_SOUTH_PA, NVT_SOUTH_LEN);
+	if (!gcc || !north || !south) {
+		printf("SWEET NVT: MMIO mapping failed gcc=%p north=%p south=%p\n", (void *)gcc, (void *)north, (void *)south);
+		goto out;
+	}
+
+	printf("SWEET NVT: wrap2 vote=%#x CBCR m_ahb=%#x s_ahb=%#x s0=%#x\n", rd(gcc, GCC_VOTE), rd(gcc, GCC_M_AHB),
+	    rd(gcc, GCC_S_AHB), rd(gcc, GCC_S0));
+	printf("SWEET NVT: s0 RCG cmd=%#x cfg=%#x dfsr=%#x\n", rd(gcc, GCC_RCG_CMD), rd(gcc, GCC_RCG_CFG),
+	    rd(gcc, GCC_RCG_DFSR));
+	pin_show(PIN_RESET, "reset (read only)");
+	pin_show(PIN_MISO, "spi");
+	pin_show(PIN_MOSI, "spi");
+	pin_show(PIN_CLK, "spi");
+	pin_show(PIN_CS, "cs");
+	pin_show(PIN_IRQ, "irq (read only)");
+
+	if (stage < 3) {
+		uint32_t last = rd(south, PIN_IRQ * 0x1000u + 4u) & 1u;
+		unsigned changes = 0;
+		for (unsigned i = 0; i < 40; ++i) {
+			nvt_wait_ms(50);
+			uint32_t now = rd(south, PIN_IRQ * 0x1000u + 4u) & 1u;
+			if (now != last) {
+				++changes;
+				last = now;
+			}
+		}
+		printf("SWEET NVT: irq pin changes in 2 s: %u (final level %u)\n", changes, last);
+		printf("SWEET NVT: probe done (stage 2, nothing written)\n");
+		goto out;
+	}
+
+	/* ---- stage 3 ---- */
+	if (!clocks_on()) {
+		printf("SWEET NVT: STOP at clocks\n");
+		goto out;
+	}
+	printf("SWEET NVT: clocks on: source %u Hz select %u\n", se_source_hz, se_clock_select);
+	se = ml_io_map(NVT_SE_PA, NVT_SE_LEN);
+	if (!se) {
+		printf("SWEET NVT: mapping of the engine failed\n");
+		goto out;
+	}
+	printf("SWEET NVT: engine fw revision %#x if_disable %#x hw_param0 %#x\n", rd(se, GENI_FW_REVISION_RO),
+	    rd(se, GENI_IF_DISABLE_RO), rd(se, SE_HW_PARAM_0));
+	{
+		const char *why = geni_init(1000000u);
+		if (why) {
+			printf("SWEET NVT: STOP: %s\n", why);
+			goto out;
+		}
+	}
+	pin_spi(PIN_MISO);
+	pin_spi(PIN_MOSI);
+	pin_spi(PIN_CLK);
+	pin_spi(PIN_CS);
+	printf("SWEET NVT: spi pins set; fifo depth %u words, divider for 1 MHz\n", fifo_depth);
+	pin_show(PIN_MISO, "spi");
+	pin_show(PIN_CS, "cs");
+
+	bool found = false;
+	for (int attempt = 0; attempt < 5; attempt++) {
+		uint8_t id[7] = { NVT_CHIPID_REG, 0, 0, 0, 0, 0, 0 };
+		bool ok = nvt_write_addr(NVT_SWRST_N8, 0x69u);   /* bootloader reset */
+		nvt_wait_ms(5);
+		ok = ok && nvt_write_addr(NVT_SPI_RD_FAST, 0x00u);
+		nvt_wait_ms(10);
+		ok = ok && nvt_set_page(NVT_CHIPID_PAGE) && nvt_read(id, 7);
+		printf("SWEET NVT: attempt %d ok=%d chip id bytes: %02x %02x %02x %02x %02x %02x irq=%u\n", attempt, (int)ok,
+		    id[1], id[2], id[3], id[4], id[5], id[6], rd(south, PIN_IRQ * 0x1000u + 4u) & 1u);
+		if (ok && id[4] == 0x72u && id[5] == 0x66u && id[6] == 0x03u) {
+			printf("SWEET NVT: NT36672C answered (id %02x %02x %02x %02x %02x %02x)\n", id[1], id[2], id[3],
+			    id[4], id[5], id[6]);
+			found = true;
+			break;
+		}
+	}
+	printf("SWEET NVT: RESULT stage 3: %s\n", found ? "PASS, chip id read over SPI" : "FAIL, no NT36672C id (see the attempts above)");
+	printf("SWEET NVT: stage 3 done\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_nvt_start(int stage)
+{
+	thread_t thread;
+	if (nvt_started) {
+		return;
+	}
+	nvt_started = true;
+	kern_return_t kr = kernel_thread_start(nvt_thread, (void *)(intptr_t)stage, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET NVT: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
